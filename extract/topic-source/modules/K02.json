{
  "id": "K02",
  "order": 2,
  "packageRoot": "topic-package-a",
  "title": "函数的奇偶性、周期性、图象的对称性",
  "sourcePages": [4, 5],
  "sections": [
    {
      "id": "K02-01",
      "title": "一、函数的奇偶性",
      "sourcePages": [4],
      "blocks": [
        {
          "type": "paragraph",
          "text": "（1）常见的指对型奇函数："
        },
        {
          "type": "formula",
          "tex": "y=a^x-a^{-x},y=\\frac{a^x-1}{a^x+1},y=\\frac{a^x+1}{a^x-1},y=\\ln\\frac{kx-b}{kx+b},y=\\ln\\frac{kx+b}{kx-b},y=\\log_a(x+\\sqrt{x^2+1}),y=\\log_a(\\sqrt{x^2+1}-x)."
        },
        {
          "type": "paragraph",
          "text": "（2）常见的指对型偶函数："
        },
        {
          "type": "formula",
          "tex": "y=a^x+a^{-x},y=a^{|x|},y=a^{x^2},y=\\log_a|x|,y=\\left(\\frac12+\\frac1{2^x-1}\\right)x."
        }
      ]
    },
    {
      "id": "K02-02",
      "title": "二、函数的周期性",
      "sourcePages": [4, 5],
      "blocks": [
        {
          "type": "paragraph",
          "text": "函数$y=f(x)$对定义域内任意实数$x$（$a$为常数，且$a>0$）满足："
        },
        {
          "type": "table",
          "columns": ["序号", "常见周期的表达式", "$f(x)$的周期"],
          "rows": [
            ["①", "$f(x)=f(x+a)$", "$T=a$"],
            ["②", "$f(x+a)=-f(x);f(x+a)=\\pm\\frac1{f(x)};f(x+a)=f(x-a);f(x+a)=\\frac{f(x)+1}{f(x)-1}(f(x)\\ne1);f(x+a)=\\frac{1-f(x)}{1+f(x)}(f(x)\\ne-1)$", "$T=2a$"]
          ]
        },
        {
          "type": "subheading",
          "text": "续表"
        },
        {
          "type": "table",
          "columns": ["序号", "常见周期的表达式", "$f(x)$的周期"],
          "rows": [
            ["③", "$f(x+a)=f(x+b)(a\\ne b)$", "$T=|b-a|$"],
            ["④", "$f(x+a)=-f(x+b)(a\\ne b)$", "$T=2|b-a|$"],
            ["⑤", "$f(x)$的图象关于直线$x=a$和$x=b$对称", "$T=2|b-a|$"],
            ["⑥", "$f(x)$的图象关于点$(a,0)$和点$(b,0)$对称", "$T=2|b-a|$"],
            ["⑦", "$f(x)$的图象关于直线$x=a$对称，又关于点$(b,0)$对称", "$T=4|b-a|$"],
            ["⑧", "$f(x)$是偶函数，其图象关于直线$x=a$对称", "$T=2a$"],
            ["⑨", "$f(x)$是偶函数，其图象关于点$(a,0)$对称", "$T=4a$"],
            ["⑩", "$f(x)$是奇函数，其图象关于直线$x=a$对称", "$T=4a$"],
            ["⑪", "$f(x)$是奇函数，其图象关于点$(a,0)$对称", "$T=2a$"]
          ]
        }
      ]
    },
    {
      "id": "K02-03",
      "title": "三、函数图象的对称性",
      "sourcePages": [5],
      "blocks": [
        {
          "type": "subheading",
          "text": "函数图象本身的对称性（自身对称）"
        },
        {
          "type": "table",
          "columns": ["序号", "常见对称性的表达式", "图象关于线（点）对称"],
          "rows": [
            ["①", "$f(a+x)=f(b-x)$", "关于直线$x=\\frac{a+b}{2}$对称"],
            ["推论1", "$f(a+x)=f(a-x)$", "关于直线$x=a$对称"],
            ["推论2", "$f(x)=f(2a-x)$", "关于直线$x=a$对称"],
            ["推论3", "$f(-x)=f(2a+x)$", "关于直线$x=a$对称"],
            ["②", "$f(a+x)+f(b-x)=2c$", "关于点$\\left(\\frac{a+b}{2},c\\right)$对称"],
            ["推论1", "$f(a+x)+f(a-x)=2b$", "关于点$(a,b)$对称"],
            ["推论2", "$f(x)+f(2a-x)=2b$", "关于点$(a,b)$对称"],
            ["推论3", "$f(-x)+f(2a+x)=2b$", "关于点$(a,b)$对称"]
          ]
        },
        {
          "type": "subheading",
          "text": "两个函数图象的对称性（相互对称）"
        },
        {
          "type": "table",
          "columns": ["序号", "常见对称性的表达式", "图象关于线（点）对称"],
          "rows": [
            ["①", "$y=f(x)$与$y=f(-x)$", "关于$y$轴对称"],
            ["②", "$y=f(x)$与$y=-f(x)$", "关于$x$轴对称"],
            ["③", "$y=f(x)$与$y=-f(-x)$", "关于原点对称"],
            ["④", "$y=f(x)$与其反函数$y=f^{-1}(x)$或$x=f(y)$", "关于直线$y=x$对称"],
            ["⑤", "$y=f(a+x)$与$y=f(b-x)$", "关于直线$x=\\frac{b-a}{2}$对称"],
            ["推论1", "$y=f(a+x)$与$y=f(a-x)$", "关于直线$x=0$对称"],
            ["推论2", "$y=f(x)$与$y=f(2a-x)$", "关于直线$x=a$对称"],
            ["推论3", "$y=f(-x)$与$y=f(2a+x)$", "关于直线$x=-a$对称"]
          ]
        }
      ]
    }
  ]
}
