<view class="page-shell practice-page">
  <view class="page-hero compact">
    <view class="hero-title">选择题练习</view>
    <view class="hero-subtitle">{{formulaCount}} 条公式，共 {{questionCount}} 道基础题</view>
  </view>

  <view class="page-content practice-content">
    <view class="setup-card">
      <view class="setup-summary">
        <view class="summary-item">
          <text class="summary-value">{{formulaCount}}</text>
          <text class="summary-label">公式</text>
        </view>
        <view class="summary-divider"></view>
        <view class="summary-item">
          <text class="summary-value">{{favoriteCount}}</text>
          <text class="summary-label">收藏</text>
        </view>
        <view class="summary-divider"></view>
        <view class="summary-item">
          <text class="summary-value">{{dueCount}}</text>
          <text class="summary-label">待复习</text>
        </view>
      </view>

      <view class="setup-row">
        <view class="setup-row-label">章节</view>
        <picker mode="selector" range="{{chapterLabels}}" value="{{chapterIndex}}" bindchange="onChapterChange">
          <view class="setup-picker pressable">
            <text>{{chapterLabels[chapterIndex]}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="setup-row">
        <view class="setup-row-label">每组题量</view>
        <picker mode="selector" range="{{quantityLabels}}" value="{{quantityIndex}}" bindchange="onQuantityChange">
          <view class="setup-picker pressable">
            <text>{{quantityLabels[quantityIndex]}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="setup-row">
        <view class="setup-row-label">范围</view>
        <picker mode="selector" range="{{scopeLabels}}" value="{{scopeIndex}}" bindchange="onScopeChange">
          <view class="setup-picker pressable">
            <text>{{scopeLabels[scopeIndex]}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="setup-row demo-row">
        <view class="setup-row-label">演示题</view>
        <button
          class="demo-button pressable"
          loading="{{demoStarting}}"
          disabled="{{starting || demoStarting}}"
          bindtap="startDemoSession"
        >
          <text>30 题示范</text>
          <text class="demo-button-arrow">›</text>
        </button>
      </view>

      <button
        class="primary-button start-button pressable {{starting ? 'is-loading' : ''}}"
        loading="{{starting}}"
        disabled="{{starting || demoStarting}}"
        bindtap="startSession"
      >开始练习</button>
    </view>
  </view>
</view>
