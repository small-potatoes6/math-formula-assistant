.practice-page {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.practice-content {
  padding-top: 0;
}

.setup-card {
  padding: 0 28rpx 30rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 5rpx 16rpx rgba(15, 23, 42, 0.025);
}

.setup-summary {
  display: flex;
  align-items: center;
  margin: 0 -28rpx;
  padding: 24rpx 12rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.summary-value {
  color: #15171a;
  font-size: 36rpx;
  font-weight: 750;
  line-height: 1.2;
}

.summary-label {
  margin-top: 4rpx;
  color: #98a2b3;
  font-size: 28rpx;
}

.summary-divider {
  width: 1rpx;
  height: 48rpx;
  background: #e7ebf0;
}

.setup-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 98rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.setup-row-label {
  flex: none;
  color: #475467;
  font-size: 28rpx;
}

.setup-picker {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  max-width: 430rpx;
  min-height: 64rpx;
  padding-left: 24rpx;
  color: #16856e;
  font-size: 28rpx;
  font-weight: 650;
  text-align: right;
}

.picker-arrow {
  flex: none;
  color: #25aa8d;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 1;
}

.demo-row {
  border-bottom: 0;
}

.demo-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 176rpx;
  min-height: 58rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid #b9ddd3;
  border-radius: 999rpx;
  background: #f1faf7;
  color: #16856e;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1;
}

.demo-button[disabled] {
  opacity: 0.62;
}

.demo-button-arrow {
  margin-left: 8rpx;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 1;
}

.start-button {
  width: 100%;
  margin-top: 22rpx;
}

.start-button.is-loading {
  opacity: 0.72;
}
