.practice-page {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.practice-content {
  padding-top: 0;
}

.session-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin: 0 4rpx 16rpx;
}

.session-label {
  color: #98a2b3;
  font-size: 21rpx;
  font-weight: 650;
}

.session-position {
  margin-top: 2rpx;
  color: #15171a;
  font-size: 38rpx;
  font-weight: 750;
}

.session-type {
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: #e8f8f3;
  color: #16856e;
  font-size: 21rpx;
  font-weight: 700;
}

.progress-track {
  height: 8rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e9edf2;
}

.progress-value {
  height: 100%;
  border-radius: 999rpx;
  background: #25aa8d;
  transition: width 0.2s ease;
}

.question-card {
  min-height: 690rpx;
  margin-top: 22rpx;
  padding: 30rpx 28rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 5rpx 16rpx rgba(15, 23, 42, 0.025);
}

.question-meta {
  color: #98a2b3;
  font-size: 22rpx;
}

.question-title {
  margin-top: 8rpx;
  color: #15171a;
  font-size: 38rpx;
  font-weight: 750;
  line-height: 1.35;
}

.question-hint {
  margin-top: 18rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.65;
}

.recall-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 300rpx;
  margin-top: 28rpx;
  padding: 36rpx;
  border: 2rpx dashed #d6dce5;
  border-radius: 16rpx;
  background: #f8fafc;
  text-align: center;
}

.recall-title {
  color: #475467;
  font-size: 29rpx;
  font-weight: 700;
}

.recall-copy {
  margin-top: 10rpx;
  color: #98a2b3;
  font-size: 23rpx;
  line-height: 1.65;
}

.answer-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 190rpx;
  margin-top: 24rpx;
  padding: 26rpx 16rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 16rpx;
  background: #f8fafc;
}

.answer-reveal {
  display: block;
}

.answer-label {
  margin-bottom: 14rpx;
  color: #16856e;
  font-size: 22rpx;
  font-weight: 750;
}

.reveal-button {
  width: 100%;
  margin-top: 26rpx;
}

.rating-block {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eef0f3;
}

.rating-label {
  margin-bottom: 16rpx;
  color: #667085;
  font-size: 24rpx;
  text-align: center;
}

.rating-row {
  display: flex;
  gap: 14rpx;
}

.rating-button {
  flex: 1;
  min-height: 84rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.rating-button.unknown {
  background: #fff0f1;
  color: #c44552;
}

.rating-button.fuzzy {
  background: #f1f3f6;
  color: #667085;
}

.rating-button.known {
  background: #25aa8d;
  color: #ffffff;
}

.choice-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

.choice-item {
  position: relative;
  min-height: 152rpx;
  padding: 58rpx 18rpx 18rpx;
  border: 2rpx solid #e4e7ec;
  border-radius: 16rpx;
  background: #ffffff;
}

.choice-item.correct {
  border-color: #25aa8d;
  background: #e8f8f3;
}

.choice-item.wrong {
  border-color: #df74a0;
  background: #fff0f6;
}

.choice-letter {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background: #f1f3f6;
  color: #667085;
  font-size: 23rpx;
  font-weight: 750;
}

.choice-formula {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
}

.choice-status {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  color: #667085;
  font-size: 21rpx;
  font-weight: 700;
}

.choice-item.correct .choice-status {
  color: #16856e;
}

.choice-item.wrong .choice-status {
  color: #bd4d7b;
}

.quiz-feedback {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eef0f3;
}

.feedback-title {
  color: #344054;
  font-size: 29rpx;
  font-weight: 700;
  text-align: center;
}

.next-button {
  width: 100%;
  margin-top: 20rpx;
}

.setup-card,
.finish-card {
  padding: 30rpx 28rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 5rpx 16rpx rgba(15, 23, 42, 0.025);
}

.finish-card {
  margin-bottom: 22rpx;
  text-align: center;
}

.finish-eyebrow {
  color: #16856e;
  font-size: 22rpx;
  font-weight: 750;
  letter-spacing: 1rpx;
}

.finish-title {
  margin-top: 10rpx;
  color: #15171a;
  font-size: 36rpx;
  font-weight: 750;
}

.finish-stats {
  display: flex;
  margin-top: 26rpx;
}

.finish-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.finish-value {
  color: #25aa8d;
  font-size: 42rpx;
  font-weight: 750;
}

.finish-label {
  color: #98a2b3;
  font-size: 22rpx;
}

.finish-button {
  width: 100%;
  margin-top: 26rpx;
}

.setup-label {
  color: #344054;
  font-size: 27rpx;
  font-weight: 700;
}

.practice-segment {
  display: flex;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: #f1f3f6;
}

.practice-segment .segment-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 66rpx;
  border-radius: 12rpx;
  color: #667085;
  font-size: 25rpx;
  font-weight: 650;
}

.practice-segment .segment-item.active {
  background: #ffffff;
  color: #16856e;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.08);
}

.setup-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.setup-row-label {
  color: #475467;
  font-size: 25rpx;
}

.setup-picker {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  max-width: 430rpx;
  color: #16856e;
  font-size: 24rpx;
  font-weight: 650;
}

.picker-arrow {
  color: #25aa8d;
  font-size: 29rpx;
}

.start-button {
  width: 100%;
  margin-top: 30rpx;
}

.setup-note {
  margin-top: 16rpx;
  color: #98a2b3;
  font-size: 22rpx;
  text-align: center;
}
