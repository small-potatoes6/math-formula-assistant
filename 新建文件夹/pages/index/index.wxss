.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-stats {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-top: 4rpx;
}

.hero-stat {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 52rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

.due-stat {
  background: #fff0e9;
  color: #b85f43;
}

.favorite-stat {
  background: #f1f3f6;
  color: #475467;
}

.hero-stat-value {
  font-size: 28rpx;
  font-weight: 750;
}

.hero-stat-label {
  font-size: 28rpx;
  font-weight: 650;
}

.search-box {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.025);
}

.search-icon {
  width: 42rpx;
  color: #98a2b3;
  font-size: 36rpx;
  line-height: 1;
}

.search-input {
  flex: 1;
  height: 100%;
  color: #15171a;
  font-size: 30rpx;
}

.search-placeholder {
  color: #98a2b3;
}

.search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  color: #98a2b3;
  font-size: 36rpx;
  line-height: 1;
}

.segment-control {
  display: flex;
  gap: 8rpx;
  margin-top: 22rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: #f1f3f6;
}

.segment-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 66rpx;
  border-radius: 12rpx;
  color: #667085;
  font-size: 28rpx;
  font-weight: 650;
}

.segment-item.active {
  background: #ffffff;
  color: #16856e;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.08);
}

.segment-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.segment-dot.core {
  background: #d97757;
}

.segment-dot.conclusion {
  background: #8778eb;
}

.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 2rpx 18rpx;
}

.chapter-picker {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 64rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d6dce5;
  border-radius: 14rpx;
  background: #ffffff;
  color: #344054;
  font-size: 28rpx;
  font-weight: 650;
}

.picker-arrow {
  color: #25aa8d;
  font-size: 29rpx;
}

.result-count {
  color: #98a2b3;
  font-size: 28rpx;
}

.formula-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.formula-card {
  padding: 30rpx 32rpx 24rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 5rpx 16rpx rgba(15, 23, 42, 0.025);
}

.card-head {
  display: flex;
  align-items: center;
  min-height: 48rpx;
}

.id-pill {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #fff0e9;
  color: #b85f43;
  font-size: 28rpx;
  font-weight: 750;
}

.id-pill.conclusion {
  background: #f0eeff;
  color: #6656c7;
}

.card-chapter {
  flex: 1;
  margin-left: 14rpx;
  overflow: hidden;
  color: #98a2b3;
  font-size: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.favorite-star {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  margin: -10rpx -12rpx -10rpx 0;
  border-radius: 50%;
  color: #aab2bf;
  font-size: 50rpx;
  line-height: 1;
  transition: color 0.14s ease, transform 0.14s ease, background-color 0.14s ease;
}

.favorite-star.active {
  color: #6eafff;
}

.favorite-star:active {
  background: #eaf3ff;
  transform: scale(0.82);
}

.formula-name {
  margin-top: 16rpx;
  color: #15171a;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
}

.formula-preview {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  min-height: 172rpx;
  margin-top: 18rpx;
  padding: 30rpx 12rpx 10rpx;
  border-top: 1rpx solid #f0f2f5;
}

.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 16rpx;
}

.type-label {
  color: #98a2b3;
  font-size: 28rpx;
  font-weight: 650;
}

.type-label.core {
  color: #b85f43;
}

.type-label.conclusion {
  color: #6656c7;
}

.detail-link {
  flex: 0 0 auto;
  padding: 8rpx 0 8rpx 16rpx;
  color: #1f8545;
  font-size: 28rpx;
  font-weight: 700;
}
