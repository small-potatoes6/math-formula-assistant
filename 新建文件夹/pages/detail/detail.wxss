.detail-page {
  min-height: 100vh;
  padding-bottom: calc(164rpx + env(safe-area-inset-bottom));
  background: #f5f6f8;
}

.detail-head {
  padding: 28rpx 32rpx 18rpx;
}

.detail-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  color: #98a2b3;
  font-size: 28rpx;
}

.detail-id {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #fff0e9;
  color: #b85f43;
  font-weight: 750;
}

.detail-id.conclusion {
  background: #f0eeff;
  color: #6656c7;
}

.detail-type {
  color: #b85f43;
  font-weight: 650;
}

.detail-type.conclusion {
  color: #6656c7;
}

.detail-dot {
  color: #d6dce5;
}

.detail-title {
  margin-top: 16rpx;
  color: #15171a;
  font-size: 50rpx;
  font-weight: 750;
  line-height: 1.25;
}

.mastery-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
  color: #667085;
  font-size: 28rpx;
}

.mastery-value {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #e7f8f2;
  color: #1f8545;
  font-size: 28rpx;
  font-weight: 700;
}

.mastery-dot {
  color: #d6dce5;
}

.detail-content {
  padding: 0 32rpx;
}

.formula-panel {
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  min-height: 220rpx;
  padding: 32rpx 20rpx;
  border: 1rpx solid #e4e7ec;
  border-top: 6rpx solid #d97757;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 5rpx 16rpx rgba(15, 23, 42, 0.025);
}

.formula-panel.conclusion {
  border-top-color: #8778eb;
}

.formula-stack {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.info-panel {
  margin-top: 20rpx;
  padding: 0 26rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 5rpx 16rpx rgba(15, 23, 42, 0.025);
}

.info-block {
  padding: 26rpx 0;
  border-bottom: 1rpx solid #eef0f3;
}

.info-block:last-child {
  border-bottom: 0;
}

.info-label {
  margin-bottom: 10rpx;
  color: #b85f43;
  font-size: 28rpx;
  font-weight: 600;
}

.pitfall-block .info-label {
  color: #c44552;
}

.info-text {
  color: #475467;
  font-size: 30rpx;
  line-height: 1.7;
}

.explain-block {
  padding-bottom: 28rpx;
}

.explain-text {
  color: #3f3a35;
  font-size: 31rpx;
  line-height: 1.78;
}

.explain-para {
  margin-top: 16rpx;
}

.explain-para.first {
  margin-top: 0;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 22rpx 0;
}

.tag {
  padding: 7rpx 15rpx;
  border-radius: 999rpx;
  background: #f1f3f6;
  color: #667085;
  font-size: 28rpx;
}

.detail-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  gap: 18rpx;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e4e7ec;
  background: rgba(255, 255, 255, 0.97);
}

.action-button {
  flex: 1;
}

.back-action {
  gap: 10rpx;
}

.action-back-icon {
  color: #667085;
  font-size: 34rpx;
  line-height: 1;
}

.detail-empty {
  padding-top: 180rpx;
}
