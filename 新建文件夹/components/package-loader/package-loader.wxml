<view class="package-loader">
  <view class="loader-main">
    <image
      class="loader-mark"
      src="/assets/startup/pi-mark.png"
      mode="aspectFit"
    />
    <image
      class="loader-title-art"
      src="/assets/startup/title-math-universe.png"
      mode="widthFix"
    />
    <view class="loader-progress-track">
      <view class="loader-progress-value" style="width: {{progress}}%;"></view>
    </view>
  </view>
</view>
