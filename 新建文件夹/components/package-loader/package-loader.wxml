<view class="package-loader">
  <view class="loader-brand">
    <view class="loader-mark">∑</view>
    <view class="loader-title">公式记忆助手</view>
  </view>
  <view class="loader-label">{{label}}</view>
  <view class="loader-track">
    <view class="loader-value" style="width: {{progress}}%;"></view>
  </view>
  <view class="loader-detail">{{detail}}</view>
</view>
