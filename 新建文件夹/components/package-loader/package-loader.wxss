.package-loader {
  position: relative;
  min-height: 100vh;
  background: #ffffff;
  color: #202321;
  overflow: hidden;
}

.loader-main {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  text-align: center;
}

.loader-mark {
  width: 148rpx;
  height: 148rpx;
  opacity: 1;
}

.loader-title-art {
  position: absolute;
  left: 50%;
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  display: block;
  width: 690rpx;
  max-width: calc(100% - 60rpx);
  transform: translateX(-50%);
}

.loader-progress-track {
  position: absolute;
  left: 50%;
  bottom: calc(62rpx + env(safe-area-inset-bottom));
  width: 360rpx;
  height: 6rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e7ebe9;
  transform: translateX(-50%);
}

.loader-progress-value {
  height: 100%;
  border-radius: inherit;
  background: #25aa8d;
  transition: width 180ms ease;
}
